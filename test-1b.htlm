<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test Llama 3.2 1B (Limite)</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; background: #111; color: #fff; padding: 20px; line-height: 1.5; }
    h1 { color: #a855f7; font-size: 20px; }
    .box { background: #222; padding: 15px; border-radius: 10px; margin-bottom: 15px; border: 1px solid #333; }
    button { background: #6366f1; color: white; border: none; padding: 12px; border-radius: 8px; font-size: 16px; width: 100%; margin-top: 10px; cursor: pointer; }
    button:disabled { background: #444; color: #888; }
    input { width: 100%; padding: 12px; border-radius: 8px; border: 1px solid #444; background: #000; color: #fff; margin-top: 10px; box-sizing: border-box; }
    #log { background: #000; padding: 10px; border-radius: 8px; font-family: monospace; font-size: 13px; height: 120px; overflow-y: auto; color: #0f0; }
    .result { color: #fbbf24; font-weight: bold; font-size: 16px; margin-top: 10px; }
    .alert { color: #ef4444; font-weight: bold; font-size: 13px; margin-bottom: 10px; }
  </style>
</head>
<body>
  <h1>🦙 Test Llama 3.2 (1B)</h1>
  <p class="alert">⚠️ Attention : Ce modèle frôle la limite de mémoire de ton téléphone (683 Mo). La page risque de planter.</p>
  
  <div class="box">
    <button id="btn-load">1. Télécharger le modèle 1B (~680 Mo)</button>
    <input type="text" id="input-prompt" placeholder="Ex: Explique-moi ce qu'est la photosynthèse" value="Explique-moi ce qu'est la photosynthèse simplement.">
    <button id="btn-gen" disabled>2. Générer la réponse</button>
    <div id="res" class="result"></div>
  </div>

  <div class="box">
    <h3>Logs :</h3>
    <div id="log">En attente...</div>
  </div>

  <script type="module">
    import * as webllm from "https://esm.run/@mlc-ai/web-llm";

    const logEl = document.getElementById('log');
    let engine = null;

    function addLog(msg) {
      logEl.innerHTML += `<br>> ${msg}`;
      logEl.scrollTop = logEl.scrollHeight;
    }

    document.getElementById('btn-load').onclick = async () => {
      const btn = document.getElementById('btn-load');
      btn.disabled = true;
      btn.textContent = "Téléchargement...";

      try {
        addLog("Initialisation de WebLLM...");
        // C'est ici qu'on définit le modèle 1B
        engine = await webllm.CreateMLCEngine(
          "Llama-3.2-1B-Instruct-q4f16_1-MLC",
          { initProgressCallback: (report) => addLog(report.text) }
        );
        addLog("✅ Modèle chargé avec succès !");
        btn.textContent = "Modèle Prêt";
        document.getElementById('btn-gen').disabled = false;
      } catch (error) {
        addLog("❌ ERREUR (Manque de mémoire ou WebGPU non supporté) : " + error.message);
        btn.disabled = false;
        btn.textContent = "Réessayer";
      }
    };

    document.getElementById('btn-gen').onclick = async () => {
      if (!engine) return;
      const prompt = document.getElementById('input-prompt').value;
      const btn = document.getElementById('btn-gen');
      btn.disabled = true;
      document.getElementById('res').textContent = "Réflexion...";
      addLog(`Génération pour : "${prompt}"`);

      try {
        const reply = await engine.chat.completions.create({
          messages: [
            { role: "system", content: "Tu es un assistant utile et concis. Réponds en français." },
            { role: "user", content: prompt }
          ],
          temperature: 0.7,
          max_tokens: 300
        });
        document.getElementById('res').textContent = reply.choices[0].message.content;
        addLog("✅ Réponse générée !");
      } catch (e) {
        addLog("❌ Erreur de génération : " + e.message);
        document.getElementById('res').textContent = "Erreur.";
      }
      btn.disabled = false;
    };
  </script>
</body>
</html>
